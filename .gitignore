# ============================================================
# 站点源码白名单：仅跟踪 homepage.html 及其依赖的 css / images
# 除此之外的一切（其它页面、草稿、备份、素材）全部排除
# ============================================================

# 1) 先排除根目录下所有内容
/*

# 2) 放行 gitignore 自身与首页
!/.gitignore
!/homepage.html

# 3) 放行样式目录，但只保留首页用到的两个 css
!/css
/css/*
!/css/style.css
!/css/homepage.css

# 4) 放行图片目录（逐级放行后再指定具体文件）
!/images
/images/*

!/images/avatars
/images/avatars/*
!/images/avatars/candidates
/images/avatars/candidates/*
!/images/avatars/candidates/*.png

!/images/Product Categories
/images/Product Categories/*
!/images/Product Categories/*.jpeg

!/images/Glassware Customization.png
!/images/homechoose.webp
!/images/labels-wraps-300x300.png
!/images/lids-sprayers-300x300.png
!/images/racks-handles-300x300.png
!/images/we_serve_center.png
